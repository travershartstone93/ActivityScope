+// The words of a question as the trainer (tools/kindtrain.py) sees them: ASCII lower case, runs of letters,
+// digits and '%'. Everything else, non-ASCII included, separates words.
+std::vector<std::string> plain_words(const std::string& s) {
+    std::vector<std::string> out;
+    std::string cur;
+    for (unsigned char c : s) {
+        if (c >= 'A' && c <= 'Z') c = static_cast<unsigned char>(c + 32);
+        if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '%') {
+            cur += char(c);
+        } else if (!cur.empty()) {
+            out.push_back(cur);
+            cur.clear();
+        }
+    }
+    if (!cur.empty()) out.push_back(cur);
+    return out;
+}
+
+// The linear matcher: tf-idf over words and character 3-5-grams, one weight row per feature, one logit per kind.
+// Written by tools/kindtrain.py as weights.bin beside phrasings.tsv; absent, the nearest phrasing decides.
+struct Linear {
+    std::vector<std::string> ids;
+    std::vector<float> bias;
+    std::unordered_map<std::string, int> word, gram;  // feature -> row
+    std::vector<float> idf;                           // per row
+    std::vector<float> w;                             // rows x kinds
+    std::unordered_map<std::string, std::string> chat, syn;
+    int nk = 0, nf = 0;
+    bool ok = false;
+
+    bool load(const std::string& path) {
+        std::ifstream in(path, std::ios::binary);
+        if (!in) return false;
+        char magic[8];
+        in.read(magic, 8);
+        if (!in || std::memcmp(magic, "ASKLIN1\0", 8) != 0) return false;
+        int32_t nchat = 0, nsyn = 0;
+        in.read(reinterpret_cast<char*>(&nk), 4);
+        in.read(reinterpret_cast<char*>(&nf), 4);
+        in.read(reinterpret_cast<char*>(&nchat), 4);
+        in.read(reinterpret_cast<char*>(&nsyn), 4);
+        auto str = [&] {
+            uint16_t n = 0;
+            in.read(reinterpret_cast<char*>(&n), 2);
+            std::string s(n, '\0');
+            in.read(s.data(), n);
+            return s;
+        };
+        auto f32 = [&] {
+            float v = 0;
+            in.read(reinterpret_cast<char*>(&v), 4);
+            return v;
+        };
+        for (int k = 0; k < nk; ++k) {
+            ids.push_back(str());
+            bias.push_back(f32());
+        }
+        idf.resize(std::size_t(nf));
+        for (int i = 0; i < nf; ++i) {
+            char block = 0;
+            in.read(&block, 1);
+            std::string f = str();
+            idf[std::size_t(i)] = f32();
+            (block == 0 ? word : gram)[f] = i;
+        }
+        w.resize(std::size_t(nf) * std::size_t(nk));
+        in.read(reinterpret_cast<char*>(w.data()), std::streamsize(w.size() * sizeof(float)));
+        for (int i = 0; i < nchat; ++i) {
+            std::string a = str();
+            chat[a] = str();
+        }
+        for (int i = 0; i < nsyn; ++i) {
+            std::string a = str();
+            syn[a] = str();
+        }
+        ok = bool(in) && nk > 0 && nf > 0;
+        return ok;
+    }
+
+    std::vector<std::string> normalized(const std::string& question) const {
+        std::vector<std::string> out;
+        for (const std::string& raw : plain_words(question)) {
+            auto c = chat.find(raw);
+            for (const std::string& piece : plain_words(c == chat.end() ? raw : c->second)) {
+                auto s = syn.find(piece);
+                out.push_back(s == syn.end() ? piece : s->second);
+            }
+        }
+        return out;
+    }
+
+    // One probability per kind, in ids order.
+    std::vector<float> probabilities(const std::string& question) const {
+        std::unordered_map<int, float> words, grams;
+        for (const std::string& t : normalized(question)) {
+            if (auto it = word.find(t); it != word.end()) words[it->second] += 1;
+            const std::string padded = " " + t + " ";
+            for (std::size_t n = 3; n <= 5; ++n)
+                for (std::size_t i = 0; i + n <= padded.size(); ++i)
+                    if (auto it = gram.find(padded.substr(i, n)); it != gram.end()) grams[it->second] += 1;
+        }
+        std::vector<float> logits(bias);
+        for (auto* bag : {&words, &grams}) {
+            double norm = 0;
+            for (auto& [row, count] : *bag) {
+                count = (1.0f + std::log(count)) * idf[std::size_t(row)];
+                norm += double(count) * count;
+            }
+            const float scale = norm > 0 ? float(1.0 / std::sqrt(norm)) : 0.0f;
+            for (const auto& [row, x] : *bag) {
+                const float* wr = w.data() + std::size_t(row) * std::size_t(nk);
+                for (int k = 0; k < nk; ++k) logits[std::size_t(k)] += x * scale * wr[k];
+            }
+        }
+        const float top = *std::max_element(logits.begin(), logits.end());
+        double sum = 0;
+        for (float& l : logits) sum += (l = std::exp(l - top));
+        for (float& l : logits) l = float(l / sum);
+        return logits;
+    }
+};
